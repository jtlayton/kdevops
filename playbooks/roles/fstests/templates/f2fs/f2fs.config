# Automatically generated file by kdevops {{ kdevops_version }}
[default]
FSTYP=f2fs
TEST_DIR={{ fstests_test_dir }}
SCRATCH_MNT={{ fstests_scratch_mnt }}
RESULT_BASE=$PWD/results/$HOST/$(uname -r)
DUMP_CORRUPT_FS=1
CANON_DEVS=yes
RECREATE_TEST_DEV=true
{% if fstests_soak_duration > 0 -%}
SOAK_DURATION={{ fstests_soak_duration }}
{% endif %}


{% if fstests_f2fs_section_reflink -%}
[f2fs_reflink]
TEST_DEV={{ fstests_test_dev }}
SCRATCH_DEV_POOL="{{ fstests_scratch_devpool }}"
MKFS_OPTIONS='-f'
{% if fstests_f2fs_mount_quota_opts is defined and fstests_f2fs_mount_quota_opts|length > 0 -%}
MOUNT_OPTIONS='-o {{ fstests_f2fs_mount_quota_opts }}'
TEST_FS_MOUNT_OPTS="$TEST_FS_MOUNT_OPTS -o {{ fstests_f2fs_mount_quota_opts }}"
{% endif %}
USE_EXTERNAL=no
LOGWRITES_DEV={{ fstests_logwrites_dev }}
{% endif %}

{% if fstests_f2fs_section_reflink_4k -%}
[f2fs_reflink_4k]
TEST_DEV={{ fstests_test_dev }}
SCRATCH_DEV_POOL="{{ fstests_scratch_devpool }}"
MKFS_OPTIONS='-f'
{% if fstests_f2fs_mount_quota_opts is defined and fstests_f2fs_mount_quota_opts|length > 0 -%}
MOUNT_OPTIONS='-o {{ fstests_f2fs_mount_quota_opts }}'
TEST_FS_MOUNT_OPTS="$TEST_FS_MOUNT_OPTS -o {{ fstests_f2fs_mount_quota_opts }}"
{% endif %}
USE_EXTERNAL=no
LOGWRITES_DEV={{ fstests_logwrites_dev }}
{% endif %}

{% if fstests_f2fs_section_nocrc -%}
[f2fs_nocrc]
TEST_DEV={{ fstests_test_dev }}
SCRATCH_DEV_POOL="{{ fstests_scratch_devpool }}"
MKFS_OPTIONS='-f'
{% if fstests_f2fs_mount_quota_opts is defined and fstests_f2fs_mount_quota_opts|length > 0 -%}
MOUNT_OPTIONS='-o {{ fstests_f2fs_mount_quota_opts }}'
TEST_FS_MOUNT_OPTS="$TEST_FS_MOUNT_OPTS -o {{ fstests_f2fs_mount_quota_opts }}"
{% endif %}
USE_EXTERNAL=no
LOGWRITES_DEV={{ fstests_logwrites_dev }}
{% endif %}

{% if fstests_f2fs_section_nocrc_4k -%}
[f2fs_nocrc_4k]
TEST_DEV={{ fstests_test_dev }}
SCRATCH_DEV_POOL="{{ fstests_scratch_devpool }}"
MKFS_OPTIONS='-f'
{% if fstests_f2fs_mount_quota_opts is defined and fstests_f2fs_mount_quota_opts|length > 0 -%}
MOUNT_OPTIONS='-o {{ fstests_f2fs_mount_quota_opts }}'
TEST_FS_MOUNT_OPTS="$TEST_FS_MOUNT_OPTS -o {{ fstests_f2fs_mount_quota_opts }}"
{% endif %}
USE_EXTERNAL=no
LOGWRITES_DEV={{ fstests_logwrites_dev }}
{% endif %}
